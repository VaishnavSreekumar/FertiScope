*~

# Data Directory - STRICT PRIVACY & RESEARCH INTEGRITY:
# Never commit raw patient-level data, extracted splits, or image archives.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Checksums and metadata are tracked, but binary patient data is ignored
*.xlsx
*.xls
*.csv
*.zip
*.parquet
*.db
*.sqlite

# Environment variables & secrets
.env
.env.local

